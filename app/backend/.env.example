# Modèle des variables du backend. Copier en .env (jamais commité) et remplir les valeurs.
# En production, ces variables se saisissent dans le tableau de bord de l'hébergeur (pas de fichier .env).

# --- Envoi des mails (obligatoire : le serveur refuse de démarrer sans) ---
SMTP_HOST=mail.privateemail.com
# 465 = SSL (recommandé) ; 587 = STARTTLS
SMTP_PORT=465
# Boîte qui envoie les mails (idéalement dédiée, ex. noreply@proxiatech.com)
SMTP_USER=
SMTP_PASS=
# Boîte qui reçoit les formulaires
CONTACT_EMAIL=

# --- Serveur (facultatif) ---
# Port d'écoute ; la plupart des hébergeurs le fournissent eux-mêmes
# PORT=8000
# Mettre "production" chez l'hébergeur
# NODE_ENV=production

# --- Selon l'hébergement (à régler une fois l'hébergeur connu) ---
# Nombre de proxys devant le backend : 0 en local, 1 derrière l'hébergeur, 2 si Cloudflare est aussi devant
TRUST_PROXY=0
# Seulement si le front est sur un AUTRE domaine que l'API (ex. API sur api.proxiatech.com) :
# CORS_ORIGIN=https://proxiatech.com
